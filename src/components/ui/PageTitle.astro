---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

<header class="page-title">
  {eyebrow && <p class="page-title__eyebrow">{eyebrow}</p>}
  <h1 class="page-title__h1 serif">{title}</h1>
  {intro && <p class="page-title__intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-title {
    margin-bottom: var(--space-8);
  }

  .page-title__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--grey);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-title__h1 {
    font-size: var(--text-h1);
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .page-title__intro {
    margin-top: var(--space-5);
    max-width: 32rem;
    color: var(--grey);
    font-size: var(--text-body);
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
