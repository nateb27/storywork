---
/**
 * A plain list of entries: title, one-line description, an optional
 * pill on the right, hairline between rows. Used for days, method
 * chapters and anything else that reads as a table of contents.
 */
export interface ListItem {
  href?: string;
  title: string;
  description?: string;
  /** Small label before the title, e.g. "Day 3" */
  label?: string;
  pill?: 'today' | 'locked' | null;
  done?: boolean;
}

interface Props {
  items: ListItem[];
}

const { items } = Astro.props;
---

<ol class="items" role="list">
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li class:list={['item', { 'item--done': item.done, 'item--locked': item.pill === 'locked' }]}>
          <Tag class="item__link" href={item.href} data-astro-prefetch={item.href ? '' : undefined}>
            <span class="item__text">
              <span class="item__title">
                {item.label && <span class="item__label">{item.label}</span>}
                {item.title}
              </span>
              {item.description && <span class="item__description">{item.description}</span>}
            </span>
            <span class="item__aside">
              {item.pill === 'today' && <span class="pill pill--today">Today</span>}
              {item.pill === 'locked' && <span class="pill pill--locked">Locked</span>}
              {item.done && (
                <span class="item__check" aria-label="Done">
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <circle cx="10" cy="10" r="9" fill="currentColor" />
                    <path d="M6 10.4l2.6 2.6L14.2 7.4" fill="none" stroke="var(--paper)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              )}
            </span>
          </Tag>
        </li>
      );
    })
  }
</ol>

<style>
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item + .item {
    border-top: 1px solid var(--hairline);
  }

  .item__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    color: inherit;
    text-decoration: none;
  }

  a.item__link {
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  a.item__link:hover {
    transform: translateX(3px);
  }

  .item__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .item__title {
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
  }

  .item__label {
    margin-right: 0.55em;
    color: var(--grey-faint);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .item__description {
    color: var(--grey);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .item__aside {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2);
  }

  .item__check {
    display: inline-flex;
    color: var(--grey-faint);
  }

  .item--done .item__title {
    color: var(--grey);
  }

  .item--locked .item__title,
  .item--locked .item__description {
    color: var(--grey-faint);
  }
</style>
