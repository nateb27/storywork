---
import Library from '@/layouts/Library.astro';
import PageTitle from '@/components/ui/PageTitle.astro';
import { collectionById } from '@/data/collections';
import { getShelf, dayHref } from '@/lib/content';

const c = collectionById('shelf');
const books = await getShelf();
---

<Library title={c.name} active="shelf">
  <PageTitle title={c.name} intro={c.intro} />

  <ul class="books" role="list">
    {
      books.map((b) => (
        <li class="book">
          <div class="book__head">
            <span class="book__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="16" height="16">
                <path d="M4 3.5h8.5a2 2 0 0 1 2 2V16.5H6a2 2 0 0 1-2-2v-11z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                <path d="M4 14.5a2 2 0 0 1 2-2h8.5" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
            <div>
              <h2 class="book__title serif">{b.work}</h2>
              <p class="book__byline">
                {b.author}, {b.year}
                {b.translator && <> · translated by {b.translator}</>}
              </p>
            </div>
          </div>
          {b.note && <p class="book__note serif">{b.note}</p>}
          <p class="book__links">
            {b.days.map((n) => (
              <a class="book__day" href={dayHref(n)}>Day {n}</a>
            ))}
            {b.link && (
              <a class="book__read" href={b.link} target="_blank" rel="noopener">
                Read it free
                <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path d="M4 2.5h5.5V8M9.5 2.5L3 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</Library>

<style>
  .books {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book__head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .book__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.15rem;
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--grey);
  }

  .book__title {
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .book__byline {
    margin-top: 0.1rem;
    color: var(--grey);
    font-size: var(--text-sm);
  }

  .book__note {
    margin: var(--space-4) 0 0 calc(1.75rem + var(--space-3));
    padding-left: var(--space-4);
    border-left: 2px solid var(--hairline);
    color: var(--ink-soft);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .book__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0 calc(1.75rem + var(--space-3));
  }

  .book__day {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--grey);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .book__day:hover {
    color: var(--ink);
  }

  .book__read {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin-left: var(--space-2);
    color: var(--ink);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .book__note,
    .book__links {
      margin-left: 0;
    }
  }
</style>
