---
import { PUBLIC_OTP_LENGTH, PUBLIC_SUPPORT_EMAIL } from 'astro:env/client';
import Base from '@/layouts/Base.astro';
import Mark from '@/components/ui/Mark.astro';
import LoginForm from '@/components/auth/LoginForm';
import { safeNext } from '@/lib/access';

const next = safeNext(Astro.url.searchParams.get('next'));
const signedOut = Astro.url.searchParams.has('signedout');

// Already signed in: skip the form
if (Astro.locals.member && !signedOut) return Astro.redirect(next, 302);
---

<Base title="Sign in">
  <main id="main" class="login">
    <a href="/library" class="login-brand" aria-label="Storywork">
      <Mark size={36} />
      <span class="serif">Storywork</span>
    </a>
    <LoginForm
      client:load
      next={next}
      codeLength={PUBLIC_OTP_LENGTH}
      joinHref="/checkout"
      supportEmail={PUBLIC_SUPPORT_EMAIL}
      signedOut={signedOut}
    />
  </main>
</Base>

<style is:global>
  .login {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100svh;
    padding: max(14vh, 4rem) var(--gutter) var(--space-7);
  }

  .login-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    color: var(--ink);
    text-decoration: none;
  }

  .login-brand .serif {
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .login-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 24rem;
  }

  .login-note {
    margin-bottom: var(--space-5);
    color: var(--grey);
    font-size: var(--text-sm);
    text-align: center;
  }

  .login-label {
    margin-bottom: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .login-input {
    height: 3rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-base);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .login-input::placeholder {
    color: var(--grey-faint);
  }

  .login-input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .login-input[aria-invalid] {
    border-color: var(--danger);
  }

  .login-error {
    margin-top: var(--space-2);
    color: var(--danger);
    font-size: var(--text-sm);
  }

  .login-submit {
    width: 100%;
    min-height: 3rem;
    margin-top: var(--space-4);
    border-radius: var(--radius);
    font-size: var(--text-base);
  }

  .login-submit:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .login-hint {
    margin-top: var(--space-3);
    color: var(--grey);
    font-size: var(--text-xs);
    text-align: center;
  }

  .login-card--code {
    align-items: center;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-align: center;
  }

  .login-code-title {
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .login-code-copy {
    margin-top: var(--space-2);
    color: var(--grey);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .login-code-copy strong {
    color: var(--ink-soft);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .login-dev {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--grey-faint);
    border-radius: var(--radius-sm);
    color: var(--grey);
    font-size: var(--text-xs);
  }

  .login-dev code {
    color: var(--ink);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
  }

  .otp {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .otp__slot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .otp__dash {
    color: var(--grey-faint);
  }

  .otp__box {
    width: 2.6rem;
    height: 3.1rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
    caret-color: var(--accent);
    transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .otp__box:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .otp__box:disabled {
    opacity: 1;
  }

  .otp--success .otp__box {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .login-code-status {
    min-height: 1.5em;
    margin-top: var(--space-3);
    color: var(--grey);
    font-size: var(--text-sm);
  }

  .login-code-status.is-error {
    color: var(--danger);
  }

  .login-code-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .login-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .login-muted {
    color: var(--grey);
  }

  .login-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 24rem;
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    color: var(--grey);
    font-size: var(--text-sm);
    text-align: center;
  }

  .login-foot a {
    color: var(--ink);
  }

  @media (max-width: 400px) {
    .otp {
      gap: 0.3rem;
    }

    .otp__slot {
      gap: 0.3rem;
    }

    .otp__box {
      width: 2.2rem;
      height: 2.8rem;
    }
  }
</style>
