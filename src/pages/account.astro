---
import { PUBLIC_SUPPORT_EMAIL } from 'astro:env/client';
import Library from '@/layouts/Library.astro';
import PageTitle from '@/components/ui/PageTitle.astro';
import { hasAddon } from '@/lib/access';

const { member, products } = Astro.locals;
const ownsChallenge = products.includes('challenge');
const ownsAddon = hasAddon(products);
---

<Library title="Account">
  <PageTitle title="Account" />

  <dl class="account">
    <div class="account__row">
      <dt>Signed in as</dt>
      <dd>{member?.email}</dd>
    </div>
    <div class="account__row">
      <dt>The Ten Days</dt>
      <dd>{ownsChallenge ? 'Yours' : <a href="/checkout?product=challenge">Buy the challenge</a>}</dd>
    </div>
    <div class="account__row">
      <dt>Five More</dt>
      <dd>{ownsAddon ? 'Yours' : <a href="/checkout?product=addon">Add Five More</a>}</dd>
    </div>
    <div class="account__row">
      <dt>Help</dt>
      <dd><a href={`mailto:${PUBLIC_SUPPORT_EMAIL}`}>{PUBLIC_SUPPORT_EMAIL}</a></dd>
    </div>
  </dl>

  <form method="post" action="/api/auth/signout" class="account__signout">
    <button type="submit" class="button button--quiet">Sign out</button>
  </form>
</Library>

<style>
  .account {
    margin: 0;
  }

  .account__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--hairline);
  }

  .account__row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  dt {
    color: var(--grey);
    font-size: var(--text-sm);
  }

  dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .account__signout {
    margin-top: var(--space-7);
  }
</style>
